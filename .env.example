# Copy to .env and edit. The Makefile loads it automatically.
# Only `make report` (the LLM judge) needs these. Baselines, tests and the demo need none.

# Wire format: "openai" for any OpenAI-compatible /chat/completions endpoint
# (OpenAI, OpenRouter, Together, Azure OpenAI v1, vLLM, Ollama, ...), or "anthropic".
EVALBRIDGE_PROVIDER=openai

# Base URL. Defaults: https://api.openai.com/v1 (openai) or https://api.anthropic.com (anthropic).
# Examples: https://openrouter.ai/api/v1   http://localhost:11434/v1 (Ollama)
EVALBRIDGE_API_BASE=

EVALBRIDGE_API_KEY=
EVALBRIDGE_MODEL=

# Optional
# EVALBRIDGE_PROMPT=pairwise_v1          # file in src/evalbridge/prompts/
# EVALBRIDGE_MAX_TOKENS=1024
# EVALBRIDGE_TIMEOUT_S=120
# EVALBRIDGE_CACHE_DIR=.cache/evalbridge # SQLite cache of every judge reply
# EVALBRIDGE_DATA_DIR=data/raw           # where the MT-Bench parquet files are cached
